# 管理员前端 Dockerfile
FROM node:20-alpine AS builder
WORKDIR /app
COPY flea-market-management/package*.json ./
RUN npm install
COPY flea-market-management/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY admin/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
